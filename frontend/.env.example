# Base URL of the Aptly FastAPI backend. The backend runs locally on your own
# machine (see the root README.md) even when this frontend is hosted publicly —
# Ollama and Chroma are never hosted remotely. Copy this file to `.env.local`
# and adjust only if you're running the backend on a non-default host/port.
VITE_API_BASE_URL=http://localhost:8000
